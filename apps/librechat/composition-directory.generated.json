  {
    "component": "SourceReference",
    "category": "content",
    "props_schema": {
      "$defs": {
        "MaterialCitation": {
          "additionalProperties": false,
          "properties": {
            "binding_id": {
              "format": "uuid",
              "title": "Binding Id",
              "type": "string"
            },
            "binding_revision": {
              "minimum": 1,
              "title": "Binding Revision",
              "type": "integer"
            },
            "purpose": {
              "enum": [
                "reference",
                "planning",
                "lesson",
                "teaching",
                "item_author",
                "item_review",
                "indexing"
              ],
              "title": "Purpose",
              "type": "string"
            },
            "ref": {
              "$ref": "#/$defs/MaterialRef"
            }
          },
          "required": [
            "binding_id",
            "binding_revision",
            "purpose",
            "ref"
          ],
          "title": "MaterialCitation",
          "type": "object"
        },
        "MaterialRef": {
          "additionalProperties": false,
          "properties": {
            "document_id": {
              "format": "uuid",
              "title": "Document Id",
              "type": "string"
            },
            "document_revision": {
              "minimum": 1,
              "title": "Document Revision",
              "type": "integer"
            },
            "block_id": {
              "format": "uuid",
              "title": "Block Id",
              "type": "string"
            },
            "span": {
              "$ref": "#/$defs/MaterialSpan"
            },
            "content_digest": {
              "pattern": "^[0-9a-f]{64}$",
              "title": "Content Digest",
              "type": "string"
            },
            "selection_id": {
              "anyOf": [
                {
                  "format": "uuid",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Selection Id"
            }
          },
          "required": [
            "document_id",
            "document_revision",
            "block_id",
            "span",
            "content_digest"
          ],
          "title": "MaterialRef",
          "type": "object"
        },
        "MaterialSpan": {
          "additionalProperties": false,
          "properties": {
            "start": {
              "minimum": 0,
              "title": "Start",
              "type": "integer"
            },
            "end": {
              "exclusiveMinimum": 0,
              "title": "End",
              "type": "integer"
            }
          },
          "required": [
            "start",
            "end"
          ],
          "title": "MaterialSpan",
          "type": "object"
        },
        "SourceRef": {
          "additionalProperties": false,
          "properties": {
            "source_id": {
              "format": "uuid",
              "title": "Source Id",
              "type": "string"
            },
            "revision": {
              "title": "Revision",
              "type": "integer"
            }
          },
          "required": [
            "source_id",
            "revision"
          ],
          "title": "SourceRef",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "label": {
          "maxLength": 120,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Label",
          "type": "string"
        },
        "citation": {
          "anyOf": [
            {
              "$ref": "#/$defs/MaterialCitation"
            },
            {
              "$ref": "#/$defs/SourceRef"
            }
          ],
          "title": "Citation"
        }
      },
      "required": [
        "label",
        "citation"
      ],
      "title": "CitationProps",
      "type": "object"
    },
    "state_kinds": [],
    "outputs": [
      "open_source"
    ],
    "authority": "presentation_only; host owns permission, execution and results"
  },
