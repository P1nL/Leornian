{
  "name": "leornian",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.8.0",
  "scripts": {
    "dev": "pnpm librechat:connected",
    "librechat:preview": "node apps/librechat/preview.mjs",
    "librechat:build-preview": "node apps/librechat/build-preview.mjs",
    "librechat:build-native": "node apps/librechat/build-native.mjs",
    "librechat:native": "node apps/librechat/native-server.mjs",
    "librechat:build-connected": "node apps/librechat/build-connected.mjs",
    "librechat:connected": "node apps/librechat/connected-server.mjs",
    "librechat:test": "node --test apps/librechat/*.test.mjs && pnpm --filter @leornian/desktop exec vitest run --config ../librechat/vitest.config.mjs",
    "build": "pnpm librechat:build-connected",
    "desktop:web-dev": "pnpm --filter @leornian/desktop dev",
    "desktop:build": "pnpm --filter @leornian/desktop build",
    "check": "pnpm --filter @leornian/desktop check",
    "test": "pnpm --filter @leornian/desktop test",
    "contracts": "uv run --directory backend leornian-schema && pnpm --filter @leornian/api-contracts generate",
    "desktop:dev": "pnpm --filter @leornian/desktop tauri dev"
  }
}
