ARG BASE_IMAGE=python:3.12-slim
FROM ${BASE_IMAGE}
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/leornian/browsers
RUN python -m pip --isolated install --index-url https://pypi.org/simple \
    --only-binary=:all: --no-deps --no-cache-dir \
    "playwright==1.64.1" "pyee==14.0.0" "greenlet==3.5.6" "typing_extensions==4.15.0"
RUN python -m playwright install --with-deps --only-shell chromium \
    && chmod -R a+rX /opt/leornian/browsers \
    && rm -rf /var/lib/apt/lists/*
