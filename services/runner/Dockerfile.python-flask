ARG BASE_IMAGE=python:3.12-slim
FROM ${BASE_IMAGE}
RUN python -m pip --isolated install --index-url https://pypi.org/simple \
    --only-binary=:all: --no-deps --no-cache-dir \
    "Flask==3.1.2" "blinker==1.9.0" "click==8.3.1" "itsdangerous==2.2.0" \
    "Jinja2==3.1.6" "MarkupSafe==3.0.3" "Werkzeug==3.1.4"
