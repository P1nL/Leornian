# Local development only. Copy to .env and set a unique password before starting.
LEORNIAN_POSTGRES_PASSWORD=

# A Chat Completions compatible endpoint, not a Sidecar. No default provider or model.
# Enabling sends the selected goal, lesson, feedback, admitted excerpts and necessary conversation.
# New automatic supply requests may make successive repair/revision calls until qualified delivery.
# No fixed attempt cap; cancel the supply task to stop new generation authorizations.
LEORNIAN_MODEL_ENABLED=false
LEORNIAN_MODEL_BASE_URL=
LEORNIAN_MODEL_NAME=
LEORNIAN_MODEL_API_KEY=
# Optional provider extension. Thinking tool turns use auto choice and private reasoning replay.
LEORNIAN_MODEL_THINKING=
# Optional per-stage JSON overrides; enable only on a channel supporting this extension.
# Empty means no overrides. tutor.v1 allows only the bound read-only learning_get_context.
# planner.v1, lesson.v1, delivery_review.v1 and evaluation.v1 remain tool-free.
# Thinking has no app-side reasoning-token cap. The channel's physical output/context limits
# still apply to shared reasoning+content; the stage body reservation is not max_tokens.
LEORNIAN_MODEL_STAGE_THINKING=
# Optional explicit channel capability. Both 0 means discover authenticated /models metadata.
# These describe the actual channel, not per-stage output or a task-total quota.
LEORNIAN_MODEL_CONTEXT_TOKENS=0
LEORNIAN_MODEL_MAX_OUTPUT_TOKENS=0

# Independent local Runner control-plane credential, never passed into learner containers.
LEORNIAN_RUNNER_TOKEN=
