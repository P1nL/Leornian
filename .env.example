# Local development only. Copy to .env and set a unique password before starting.
LEORNIAN_POSTGRES_PASSWORD=

# A Chat Completions compatible endpoint, not a Sidecar. No default provider or model.
# Enabling sends the selected goal, lesson, feedback, admitted excerpts and necessary conversation.
LEORNIAN_MODEL_ENABLED=false
LEORNIAN_MODEL_BASE_URL=
LEORNIAN_MODEL_NAME=
LEORNIAN_MODEL_API_KEY=

# Independent local Runner control-plane credential, never passed into learner containers.
LEORNIAN_RUNNER_TOKEN=
